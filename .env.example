# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=reportdesk
DB_PASSWORD=reportdesk_pass
DB_NAME=reportdesk_db
# Optional: set DB_CLIENT=sqlite to run using a local SQLite file for development
# DB_CLIENT=sqlite
# DB_SQLITE_FILE=backend/dev.sqlite

# App
JWT_SECRET=replace_this_with_a_strong_secret
NODE_ENV=development
PORT=4000
# Manager registration secret: set this to enable creating `manager` accounts during registration
# Example: MANAGER_REG_SECRET=some-very-strong-secret
# If unset, public manager registration is disabled.
MANAGER_REG_SECRET=
# Allow public manager registration (set to 'true' to enable without secret)
# WARNING: enabling this allows anyone to create manager accounts from the public signup form.
# Use only in development/testing or with other protections in place.
ALLOW_MANAGER_REG=false

# Email (for production)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
